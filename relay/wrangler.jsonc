// 見守りの中継（SPEC_01「見守り」の「中継」）の Cloudflare Workers の設定．
// Pages（アプリの配信）とは別の Worker．Pages Functions では Durable Object を定義できないため分けている．
// デプロイは人間が行う（docs/02_ENV/ENV_04「見守りの中継」）．
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tkb2608-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // *.workers.dev の住所で公開する（staging・本番の Pages から同じ中継を使う）
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // 無料プランで使える SQLite 版の Durable Object．storage は使わない（何も保存しない）
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": false }
}
