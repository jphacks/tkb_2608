{
  "name": "tkb-2608",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:record": "vite --mode record",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc && tsc -p relay && tsc -p functions",
    "lint": "biome check .",
    "format": "biome check --write .",
    "tunnel": "node scripts/tunnel.mjs",
    "replay": "node scripts/replay.mjs",
    "relay:dev": "wrangler dev --config relay/wrangler.jsonc --ip 127.0.0.1 --port 8787",
    "relay:check": "node relay/scripts/relayCheck.mjs",
    "functions:dev": "wrangler pages dev public --ip 127.0.0.1 --port 8788 --compatibility-date=2026-10-01"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "qrcode-generator": "^2.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^25.9.9",
    "@types/three": "^0.186.0",
    "playwright": "^1.64.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
