{
  "name": "tkb_2608",
  // アプリは静的サイト（Vite + three.js．docs/02_ENV/ENV_01）のため，サーバー用のコンテナは持たず単一コンテナで構成する
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // .claude/settings.json のフックは Python 3 で動き，見つからないと Read・Bash 等をすべてブロックする
    // フック用なので Ubuntu 標準の python3 だけを入れる（開発ツール一式は入れない）
    "ghcr.io/devcontainers/features/python:1": {
      "version": "os-provided",
      "installTools": false
    },
    // アプリのビルド・開発サーバー用（ENV_01 で Node.js 24 LTS に決定）
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  // Vite の開発サーバー．PC のブラウザからは localhost:5173 で開く（スマホからは cloudflared のトンネル経由．ENV_02）
  "forwardPorts": [5173],
  // CLAUDE_CONFIG_DIR を指定すると ~/.claude.json もこのディレクトリ内に置かれ，
  // 認証・設定がすべて下の名前付きボリュームに収まる
  // TZ はコミット時刻・ログ・進捗記録の日時を日本時間に揃えるため
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "TZ": "Asia/Tokyo"
  },
  // 認証情報はコンテナ内に置くと Rebuild で消えるため，名前付きボリュームに逃がす．
  // Claude Code 本体（~/.local/share/claude）も置き，Rebuild のたびに再ダウンロードしないようにする
  "mounts": [
    "source=tkb2608-claude-config,target=/home/vscode/.claude,type=volume",
    "source=tkb2608-claude-bin,target=/home/vscode/.local/share/claude,type=volume",
    "source=tkb2608-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
